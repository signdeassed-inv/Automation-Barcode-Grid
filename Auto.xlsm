Option Explicit

'=========================================================
' BARCODE SVG IMPORTER - FULL FRAME & MASKED TEXT
'=========================================================

Public Sub Import_Barcodes_A4_Auto()
    
    Dim folderPath As String
    Dim files() As String
    Dim fileCount As Long
    Dim i As Long
    Dim pageNumber As Long
    Dim positionOnPage As Long
    
    Dim ws As Worksheet
    Dim rowNumber As Long
    Dim colNumber As Long
    Dim svgPath As String
    
    '=====================================================
    ' A4 SETTINGS
    '=====================================================
    Const COLUMNS As Long = 5
    Const ROWS As Long = 14
    
    Const PAGE_WIDTH As Double = 595.27
    Const PAGE_HEIGHT As Double = 841.89
    
    Const MARGIN_X As Double = 25
    Const MARGIN_Y As Double = 25
    
    ' SET TO 0: This makes the grid frames physically touch/overlap each other
    Const GAP_X As Double = -35
    Const GAP_Y As Double = 10
    
    Dim CELL_WIDTH As Double
    Dim CELL_HEIGHT As Double
    
    ' Calculate exact cell dimensions
    CELL_WIDTH = (PAGE_WIDTH - (MARGIN_X * 2) - (GAP_X * (COLUMNS - 1))) / COLUMNS
    CELL_HEIGHT = (PAGE_HEIGHT - (MARGIN_Y * 2) - (GAP_Y * (ROWS - 1))) / ROWS
    
    '=====================================================
    ' 1. PICK FOLDER & GET FILES
    '=====================================================
    folderPath = SelectFolder()
    If folderPath = "" Then Exit Sub
    
    fileCount = GetBarcodeFiles(folderPath, files)
    If fileCount = 0 Then
        MsgBox "No SVG files found.", vbExclamation
        Exit Sub
    End If
    
    SortBarcodeFiles files, fileCount
    DeleteGeneratedSheets
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual

    '=====================================================
    ' 2. IMPORT AND ARRANGE
    '=====================================================
    pageNumber = 1
    Set ws = CreateBarcodeSheet(pageNumber)
    
    For i = 1 To fileCount
        positionOnPage = ((i - 1) Mod (COLUMNS * ROWS)) + 1
        
        If positionOnPage = 1 And i > 1 Then
            pageNumber = pageNumber + 1
            Set ws = CreateBarcodeSheet(pageNumber)
        End If
        
        rowNumber = Int((positionOnPage - 1) / COLUMNS)
        colNumber = (positionOnPage - 1) Mod COLUMNS
        
        svgPath = folderPath & "\" & files(i)
        
        Dim posX As Double, posY As Double
        posX = MARGIN_X + (colNumber * (CELL_WIDTH + GAP_X))
        posY = MARGIN_Y + (rowNumber * (CELL_HEIGHT + GAP_Y))
        
        ' Pass the exact cell frame dimensions to the inserter
        InsertBarcode ws, svgPath, posX, posY, CELL_WIDTH, CELL_HEIGHT
        
    Next i
    
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    
    MsgBox "Barcodes generated successfully!", vbInformation, "Done"

End Sub

'=========================================================
' THE BARCODE INSERTER (FULL FRAME STRETCH + TEXT MASK)
'=========================================================
Private Sub InsertBarcode(ws As Worksheet, imgPath As String, x As Double, y As Double, w As Double, h As Double)
    Dim fso As Object, ts As Object
    Dim svgContent As String, extractedText As String, tempPath As String
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    Set ts = fso.OpenTextFile(imgPath, 1, False, 0)
    svgContent = ts.ReadAll
    ts.Close
    
    Dim regEx As Object, matches As Object
    Set regEx = CreateObject("VBScript.RegExp")
    regEx.Global = True
    regEx.IgnoreCase = True
    regEx.Pattern = "<text[^>]*>([\s\S]*?)<\/text>"
    
    Set matches = regEx.Execute(svgContent)
    If matches.count > 0 Then
        extractedText = matches(0).SubMatches(0)
        Dim regExTags As Object
        Set regExTags = CreateObject("VBScript.RegExp")
        regExTags.Global = True
        regExTags.Pattern = "<[^>]+>"
        extractedText = Trim(regExTags.Replace(extractedText, ""))
    End If
    
    svgContent = regEx.Replace(svgContent, "")
    
    tempPath = Environ("TEMP") & "\temp_barcode_" & Format(Now, "hhmmss") & ".svg"
    Set ts = fso.CreateTextFile(tempPath, True, False)
    ts.Write svgContent
    ts.Close
    
    Dim textHeight As Double
    If extractedText <> "" Then
        textHeight = 14 ' Height of the text box mask
    Else
        textHeight = 0
    End If
    
    ' 1. Insert Barcode at native size (-1, -1) to bypass Excel's SVG aspect lock
    Dim pic As Shape
    On Error Resume Next
    Set pic = ws.Shapes.AddPicture(fileName:=tempPath, LinkToFile:=msoFalse, SaveWithDocument:=msoTrue, _
                                   Left:=x, Top:=y, Width:=-10, Height:=-1)
    
    If Not pic Is Nothing Then
        pic.LockAspectRatio = msoFalse
        pic.Width = w
        pic.Height = h
    End If
    
    ' 2. Insert Native Text inside the bottom of the frame
    If extractedText <> "" And Not pic Is Nothing Then
        Dim txtBox As Shape
        ' Positions the text box at the very bottom edge of the frame
        Set txtBox = ws.Shapes.AddTextbox(msoTextOrientationHorizontal, x, y + h - textHeight, w, textHeight)
        With txtBox
            .TextFrame.Characters.Text = extractedText
            .TextFrame.Characters.Font.Name = "Arial"
            .TextFrame.Characters.Font.Size = 9
            .TextFrame.Characters.Font.Bold = False
            .TextFrame.HorizontalAlignment = xlHAlignCenter
            .TextFrame.VerticalAlignment = xlVAlignCenter
            
            .TextFrame2.MarginLeft = 0
            .TextFrame2.MarginRight = 0
            .TextFrame2.MarginTop = 0
            .TextFrame2.MarginBottom = 0
            
            ' Applies a solid white background to cover the barcode lines behind the text
            .Line.Visible = msoFalse
            .Fill.Visible = msoTrue
            .Fill.ForeColor.RGB = RGB(255, 255, 255)
        End With
    End If
    On Error GoTo 0
    
    If fso.FileExists(tempPath) Then fso.DeleteFile tempPath
End Sub

'=========================================================
' HELPER FUNCTIONS
'=========================================================

Private Function SelectFolder() As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    If fd.Show = -1 Then SelectFolder = fd.SelectedItems(1) Else SelectFolder = ""
End Function

Private Function GetBarcodeFiles(folderPath As String, ByRef files() As String) As Long
    Dim fileName As String, count As Long
    count = 0
    fileName = Dir(folderPath & "\*.svg")
    Do While fileName <> ""
        count = count + 1
        ReDim Preserve files(1 To count)
        files(count) = fileName
        fileName = Dir()
    Loop
    GetBarcodeFiles = count
End Function

Private Function ExtractBarcodeNumber(fileName As String) As String
    Dim regEx As Object
    Set regEx = CreateObject("VBScript.RegExp")
    regEx.Pattern = "\d+(?=\.svg)"
    If regEx.Test(fileName) Then ExtractBarcodeNumber = regEx.Execute(fileName)(0).Value Else ExtractBarcodeNumber = "0"
End Function

Private Sub SortBarcodeFiles(ByRef files() As String, count As Long)
    Dim i As Long, j As Long, temp As String, num1 As Long, num2 As Long
    For i = 1 To count - 1
        For j = i + 1 To count
            num1 = CLng(ExtractBarcodeNumber(files(i)))
            num2 = CLng(ExtractBarcodeNumber(files(j)))
            If num1 > num2 Then
                temp = files(i): files(i) = files(j): files(j) = temp
            End If
        Next j
    Next i
End Sub

Private Sub DeleteGeneratedSheets()
    Dim ws As Worksheet
    Application.DisplayAlerts = False
    For Each ws In ThisWorkbook.Worksheets
        If ws.Name Like "Barcodes_Page_*" Then ws.Delete
    Next ws
    Application.DisplayAlerts = True
End Sub

Private Function CreateBarcodeSheet(pageNum As Long) As Worksheet
    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.count))
    ws.Name = "Barcodes_Page_" & pageNum
    Application.PrintCommunication = False
    With ws.PageSetup
        .PaperSize = xlPaperA4
        .Orientation = xlPortrait
        .LeftMargin = Application.InchesToPoints(0.2)
        .RightMargin = Application.InchesToPoints(0.2)
        .TopMargin = Application.InchesToPoints(0.2)
        .BottomMargin = Application.InchesToPoints(0.2)
    End With
    Application.PrintCommunication = True
    ActiveWindow.DisplayGridlines = False
    Set CreateBarcodeSheet = ws
End Function
